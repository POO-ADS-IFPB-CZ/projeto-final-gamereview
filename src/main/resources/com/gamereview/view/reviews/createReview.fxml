<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" alignment="TOP_LEFT" prefWidth="450.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gamereview.controller.ReviewController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <Label text="Escrever Nova Review" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <Label text="Título do Jogo:" />
    <TextField fx:id="txtGameTitle" promptText="Ex: Elden Ring" />

    <Label text="Plataforma:" />
    <TextField fx:id="txtPlatform" promptText="Ex: PC, PS5, Xbox, Switch" />

    <Label text="Nota (1.0 a 5.0):" />
    <ComboBox fx:id="cbRating" promptText="Selecione a nota..." prefWidth="200.0" />

    <Label text="Análise:" />
    <TextArea fx:id="txtReviewContent" promptText="Escreva o que achou do jogo..." prefRowCount="5" wrapText="true" />

    <Button text="Publicar Review" onAction="#handleSaveReview"
            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

    <Button text="Cancelar" onAction="#handleBack"
            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

    <Label fx:id="lblMessage" style="-fx-font-size: 13px;" />

</VBox>