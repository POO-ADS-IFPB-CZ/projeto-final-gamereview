<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="650.0" prefWidth="950.0" styleClass="main-window" stylesheets="@../style.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gamereview.controller.ReviewController">
    <children>
        <VBox maxHeight="510.0" maxWidth="500.0" spacing="12.0" styleClass="login-card">
            <padding>
                <Insets bottom="25.0" left="35.0" right="35.0" top="25.0" />
            </padding>
            <children>
                <Label styleClass="neon-title" text="NEW REVIEW" />

                <Label fx:id="lblMessage" styleClass="checkbox-text" />

                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="checkbox-text" text="Game title" style="-fx-font-weight: bold;" />
                        <TextField fx:id="txtGameTitle" prefHeight="35.0" promptText="Ex: Elden Ring" styleClass="input-field" />
                    </children>
                </VBox>

                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="checkbox-text" text="Plataform" style="-fx-font-weight: bold;" />
                                <TextField fx:id="txtPlatform" prefHeight="35.0" promptText="PC, PS5, Xbox..." styleClass="input-field" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="checkbox-text" text="Rating" style="-fx-font-weight: bold;" />
                                <!-- CORREÇÃO APLICADA ABAIXO -->
                                <ComboBox fx:id="cbRating" prefHeight="35.0" prefWidth="210.0" promptText="Choose" styleClass="input-field" style="-fx-text-fill: white;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Label styleClass="checkbox-text" text="Your Review" style="-fx-font-weight: bold;" />
                        <TextArea fx:id="txtReviewContent" prefHeight="100.0" styleClass="input-field" wrapText="true" style="-fx-text-fill: white; -fx-control-inner-background: #252b34;" />
                    </children>
                </VBox>

                <Region prefHeight="2.0" />

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="100.0" styleClass="input-field" text="Cancel" onAction="#handleBack" style="-fx-cursor: hand;" />
                        <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="130.0" styleClass="btn-login" text="Publish" onAction="#handleSaveReview" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>