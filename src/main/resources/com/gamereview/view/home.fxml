<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" styleClass="main-window" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gamereview.controller.HomeController">

    <!-- MENU SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="15.0" styleClass="login-card" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="25.0" right="25.0" />
            </padding>
            <children>
                <Label styleClass="title-label" text="GAME REVIEW" />

                <Region prefWidth="30.0" />

                <Button fx:id="btnFeed" alignment="CENTER" prefHeight="35.0" prefWidth="130.0" styleClass="btn-login" text="Feed" />
                <Button fx:id="btnProfile" alignment="CENTER" prefHeight="35.0" prefWidth="120.0" styleClass="input-field" text="My Profile"
                        onAction="#handleProfile" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="btnLogout" alignment="CENTER" prefHeight="30.0" prefWidth="100.0" styleClass="btn-login" text="LOGOUT" onAction="#handleLogout" />
            </children>
        </HBox>
    </top>

    <!-- CONTEÚDO CENTRALIZADO DO FEED -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <!-- CONTAINER CENTRAL COM LARGURA DELIMITADA (Para os cards não esticarem demais) -->
                <VBox alignment="TOP_CENTER" maxWidth="750.0" spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- CABEÇALHO DO FEED (Reviews + Botão Criar) -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0" maxWidth="750.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
    <children>
        <Label styleClass="neon-title" text="REVIEWS" />
        <Label fx:id="lblWelcome" styleClass="checkbox-text" text="Check out the latest community reviews." />
    </children>
</VBox>

                                <Button fx:id="btnCreateReview" alignment="CENTER" prefHeight="35.0" styleClass="btn-login" text="➕Review" onAction="#handleCreateReview" />
                            </children>
                        </HBox>

                        
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS" maxWidth="750.0">
                            <content>
                                <VBox fx:id="vboxReviewsContainer" alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: transparent;">
                                    <padding>
                                        <Insets bottom="10.0" left="5.0" right="5.0" top="5.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>
</BorderPane>